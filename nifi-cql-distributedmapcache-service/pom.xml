<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nifi-cql-bundle</artifactId>
        <groupId>io.github.mikethomsen</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nifi-cql-distributedmapcache-service</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.mikethomsen</groupId>
            <artifactId>nifi-cql-services-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-distributed-cache-client-service-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          No database client dependency, at any scope. This service reaches the cluster through the
          CQLExecutionService it is configured with, so the driver is a session provider's concern rather than
          this module's - which the ban-database-client-dependencies rule below enforces rather than assumes.
        -->

        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-mock</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-database-client-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>
                                        This cache reaches the cluster through the CQLExecutionService it is
                                        configured with, never through a driver directly, so no database client
                                        library belongs on this module's classpath at any scope. The CQL it
                                        builds is exercised against a real cluster where the driver already
                                        lives - the session providers' execute() coverage in AbstractCqlCrudIT -
                                        so this module has no integration tests of its own.
                                    </message>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- DataStax Java Driver 4.x, as published under both coordinates -->
                                        <exclude>org.apache.cassandra:java-driver-*</exclude>
                                        <exclude>com.datastax.oss:*</exclude>
                                        <!-- DataStax Java Driver 3.x, which Testcontainers' Cassandra module drags in -->
                                        <exclude>com.datastax.cassandra:*</exclude>
                                        <!-- ScyllaDB's shard-aware fork of the same driver -->
                                        <exclude>com.scylladb:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
