<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nifi-cql-bundle</artifactId>
        <groupId>org.apache.nifi</groupId>
        <version>2.12.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nifi-scylladb-session-provider-service-nar</artifactId>
    <packaging>nar</packaging>

    <dependencyManagement>
        <dependencies>
            <!-- Provided in nifi-cassandra-services-api-nar -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-cql-services-api-nar</artifactId>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-scylladb-session-provider-service</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-nar-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-cassandra-driver-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>
                                        This NAR runs on ScyllaDB's own fork of the DataStax driver
                                        (com.scylladb:java-driver-core), supplied by the service module. The
                                        shared module's dependency on the Apache Cassandra driver is
                                        provided-scoped for exactly this reason, and must stay that way: no
                                        Cassandra driver artifact may be bundled here, other than the query
                                        builder, which ScyllaDB does not fork. Code shared with the Cassandra
                                        service must use only the driver's core API (com.datastax.oss.driver).
                                    </message>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.apache.cassandra:*</exclude>
                                        <exclude>com.datastax.oss:*</exclude>
                                        <exclude>com.datastax.cassandra:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.apache.cassandra:java-driver-query-builder</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
